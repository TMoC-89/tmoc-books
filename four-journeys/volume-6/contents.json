      "entries": [
        {
          "id": "passage-ar-00005",
          "level": 1,
          "kind": "opening",
          "label": "الصفحات الافتتاحية"
        },
        {
          "id": "passage-ar-00064",
          "level": 2,
          "kind": "section",
          "label": "السفر الثالث: في العلم الإلهي"
        },
        {
          "id": "passage-ar-00074",
          "level": 3,
          "kind": "section",
          "label": "الفن الأول: فيما يتعلق بأحوال المبدء وصفاته وفيه مواقف"
        },
        {
          "id": "passage-ar-00075",
          "level": 1,
          "kind": "division",
          "label": "الموقف الأول: في الإشارة إلى واجب الوجود",
          "expanded": false
        },
        {
          "id": "passage-ar-00076",
          "level": 2,
          "kind": "chapter",
          "label": "١. في اثبات وجوده والوصول إلى معرفه ذاته"
        },
        {
          "id": "passage-ar-00091",
          "level": 2,
          "kind": "chapter",
          "label": "٢. في الإشارة إلى مناهج أخرى للوصول إلى هذه الوجهة الكبرى"
        },
        {
          "id": "passage-ar-00106",
          "level": 2,
          "kind": "chapter",
          "label": "٣. في الإشارة إلى وجوه من الدلائل ذكرها بعض المحققين من أهل فارس وظن أنها برهانية والى ما فيها من الاختلال"
        },
        {
          "id": "passage-ar-00111",
          "level": 2,
          "kind": "chapter",
          "label": "٤. في الإشارة إلى طرائق أخرى لا قوام"
        },
        {
          "id": "passage-ar-00117",
          "level": 2,
          "kind": "chapter",
          "label": "٥. في أن واجب الوجود آنيته مهيته"
        },
        {
          "id": "passage-ar-00128",
          "level": 2,
          "kind": "chapter",
          "label": "٦. في توحيده أي انه لا شريك له في وجوب الوجود"
        },
        {
          "id": "passage-ar-00134",
          "level": 2,
          "kind": "chapter",
          "label": "٧. في تعقيب هذا الكلام بذكر ما افاده بعض المحققين وما يرد عليه"
        },
        {
          "id": "passage-ar-00176",
          "level": 2,
          "kind": "chapter",
          "label": "٨. في أن واجب الوجود لا شريك له في الإلهية وان اله العالم واحد"
        },
        {
          "id": "passage-ar-00185",
          "level": 2,
          "kind": "chapter",
          "label": "٩. في أنه تعالى بسيط الحقيقة من كل جهة ليس مؤتلفة الذات من اجزاء وجودية عينية أو ذهنية كالمادة والصورة الخارجيتين أو الذهنيتين ولا من اجزاء حديه حملية ولا من الاجزاء المقدارية"
        },
        {
          "id": "passage-ar-00192",
          "level": 2,
          "kind": "chapter",
          "label": "١٠. في أن الواجب الوجود لا فصل لحقيقته المقدسة على أنه مقسم"
        },
        {
          "id": "passage-ar-00194",
          "level": 2,
          "kind": "chapter",
          "label": "١١. في أن واجب الوجود لا مشارك له في أي مفهوم كان"
        },
        {
          "id": "passage-ar-00199",
          "level": 2,
          "kind": "chapter",
          "label": "١٢. في أن واجب الوجود تمام الأشياء وكل الموجودات واليه يرجع الأمور كلها"
        },
        {
          "id": "passage-ar-00208",
          "level": 1,
          "kind": "division",
          "label": "الموقف الثاني: في البحث عن صفاته تعالى"
        },
        {
          "id": "passage-ar-00209",
          "level": 2,
          "kind": "chapter",
          "label": "١. في الإشارة إلى اقسام الصفات"
        },
        {
          "id": "passage-ar-00215",
          "level": 2,
          "kind": "chapter",
          "label": "٢. في قسمه أخرى رباعية للصفات الثبوتية حتى يعلم أن أيتها لائقة للذات الواجبية"
        },
        {
          "id": "passage-ar-00219",
          "level": 2,
          "kind": "chapter",
          "label": "٣. في حال ما ذكره المتأخرون في أن صفاته تعالى يجب ان يكون نفس ذاته"
        },
        {
          "id": "passage-ar-00223",
          "level": 3,
          "kind": "section",
          "label": "١. بحث من وجوه"
        },
        {
          "id": "passage-ar-00231",
          "level": 2,
          "kind": "chapter",
          "label": "٤. في تحقيق القول بعينيه الصفات الكمالية للذات الأحدية"
        },
        {
          "id": "passage-ar-00245",
          "level": 2,
          "kind": "chapter",
          "label": "٥. في ايضاح القول بان صفات الله الحقيقية كلها ذات واحده لكنها مفهومات كثيره"
        },
        {
          "id": "passage-ar-00251",
          "level": 1,
          "kind": "division",
          "label": "الموقف الثالث: في علمه تعالى"
        },
        {
          "id": "passage-ar-00252",
          "level": 2,
          "kind": "chapter",
          "label": "١. في ذكر أصول ومقدمات ينتفع بها في هذا المطلب"
        },
        {
          "id": "passage-ar-00286",
          "level": 2,
          "kind": "chapter",
          "label": "٢. في اثبات علمه بذاته"
        },
        {
          "id": "passage-ar-00291",
          "level": 2,
          "kind": "chapter",
          "label": "٣. في علمه تعالى بما سواه"
        },
        {
          "id": "passage-ar-00297",
          "level": 2,
          "kind": "chapter",
          "label": "٤. في تفصيل مذاهب الناس في علمه تعالى بالأشياء"
        },
        {
          "id": "passage-ar-00302",
          "level": 2,
          "kind": "chapter",
          "label": "٥. في الإشارة إلى بطلان مذهب الاعتزال ومذهب ينسب إلى أهل التصوف"
        },
        {
          "id": "passage-ar-00309",
          "level": 2,
          "kind": "chapter",
          "label": "٦. في حال ما ذهب إليه الأفلاطونيون القائلون بالمثل العقلية"
        },
        {
          "id": "passage-ar-00312",
          "level": 2,
          "kind": "chapter",
          "label": "٧. في حال القول بارتسام صور الأشياء في ذاته تعالى"
        },
        {
          "id": "passage-ar-00361",
          "level": 2,
          "kind": "chapter",
          "label": "٨. في تحقيق الحق في هذا المقام وفي اظهار ما نجده قادحا في مذهب القائلين بارتسام الصور في ذاته تعالى"
        },
        {
          "id": "passage-ar-00374",
          "level": 2,
          "kind": "chapter",
          "label": "٩. في حال مذهب القائلين بان علمه تعالى بما سواه علم واحد"
        },
        {
          "id": "passage-ar-00385",
          "level": 2,
          "kind": "chapter",
          "label": "١٠. فصل بلا عنوان"
        },
        {
          "id": "passage-ar-00390",
          "level": 2,
          "kind": "chapter",
          "label": "١١. في حال مذهب من كان يرى أن علمه تعالى بالأشياء هو بالإضافة الاشراقية"
        },
        {
          "id": "passage-ar-00408",
          "level": 2,
          "kind": "chapter",
          "label": "١٢. في ذكر صريح الحق وخالص اليقين ومخ القول في علمه تعالى السابق على كل شئ حتى على الصور العلمية القائمة بذاته التي هي بوجه عين الذات وبوجه غيرها كما بيناه"
        },
        {
          "id": "passage-ar-00441",
          "level": 2,
          "kind": "chapter",
          "label": "١٣. في مراتب علمه بالأشياء"
        },
        {
          "id": "passage-ar-00463",
          "level": 1,
          "kind": "division",
          "label": "الموقف الرابع: في قدرته تعالى"
        },
        {
          "id": "passage-ar-00464",
          "level": 2,
          "kind": "chapter",
          "label": "١. في تفسير معنى القدرة"
        },
        {
          "id": "passage-ar-00471",
          "level": 2,
          "kind": "chapter",
          "label": "٢. في أن القدرة فينا عين القوة والامكان وفي الواجب تعالى عين الفعلية"
        },
        {
          "id": "passage-ar-00482",
          "level": 2,
          "kind": "chapter",
          "label": "٣. في دفع ما ذكره بعض الناس"
        },
        {
          "id": "passage-ar-00487",
          "level": 2,
          "kind": "chapter",
          "label": "٤. في بيان ماخذ آخر في ابطال رأى من زعم أن شان الإرادة الواحدة ان يتعلق باي طرف من طرفي الممكن وباي ممكن من الممكنات"
        },
        {
          "id": "passage-ar-00492",
          "level": 2,
          "kind": "chapter",
          "label": "٥. في حكاية مذهب المتكلمين في المرجح والداعي لإرادة خلق العالم"
        },
        {
          "id": "passage-ar-00498",
          "level": 2,
          "kind": "chapter",
          "label": "٦. في دفع بعض الأوهام عن هذا المقام"
        },
        {
          "id": "passage-ar-00507",
          "level": 2,
          "kind": "chapter",
          "label": "٧. في تفسير الإرادة والكراهة"
        },
        {
          "id": "passage-ar-00523",
          "level": 2,
          "kind": "chapter",
          "label": "٨. في دفع ما أورد على اتحاد هذه الأمور في حقه تعالى وفي كون الإرادة القديمة سببا لايجاد الحادث"
        },
        {
          "id": "passage-ar-00538",
          "level": 2,
          "kind": "chapter",
          "label": "٩. في اعتضاد ما ذكرنا من الفرق بين اراده الله سبحانه وبين إرادتنا من طريق الرواية والنقل"
        },
        {
          "id": "passage-ar-00557",
          "level": 3,
          "kind": "section",
          "label": "١. تتميم وتحصيل"
        },
        {
          "id": "passage-ar-00562",
          "level": 2,
          "kind": "chapter",
          "label": "١٠. في حكمته تعالى وعنايته وهدايته وجوده"
        },
        {
          "id": "passage-ar-00565",
          "level": 2,
          "kind": "chapter",
          "label": "١١. في شمول ارادته لجميع الافعال"
        },
        {
          "id": "passage-ar-00579",
          "level": 2,
          "kind": "chapter",
          "label": "١٢. في حل بقيه الشبه الواردة على الإرادة القديمة وبعض الشبه الواردة على الإرادة الحادثة"
        },
        {
          "id": "passage-ar-00605",
          "level": 2,
          "kind": "chapter",
