        },
        {
          "id": "passage-ar-00079",
          "level": 2,
          "kind": "section",
          "label": "مقدمه المؤلف"
        },
        {
          "id": "passage-ar-00111",
          "level": 2,
          "kind": "section",
          "label": "الجزء الأول"
        },
        {
          "id": "passage-ar-00112",
          "level": 3,
          "kind": "section",
          "label": "من الأمور العامة أو العلم الإلهي بالمعنى الأعم"
        },
        {
          "id": "passage-ar-00113",
          "level": 2,
          "kind": "section",
          "label": "السفر الأول: وهو الذي من الخلق إلى الحق في النظر إلى طبيعة الوجود وعوارضه الذاتية وفيه مسالك"
        },
        {
          "id": "passage-ar-00114",
          "level": 3,
          "kind": "section",
          "label": "المسلك الأول: في المعارف التي يحتاج إليها الانسان في جميع العلوم وفيه مقدمه وستة مراحل"
        },
        {
          "id": "passage-ar-00115",
          "level": 4,
          "kind": "section",
          "label": "المقدمة في تعريف الفلسفة وتقسيمها الأولى وغايتها وشرفها"
        },
        {
          "id": "passage-ar-00121",
          "level": 1,
          "kind": "division",
          "label": "المرحلة الأولى: في الوجود وأقسامه الأولية",
          "expanded": true
        },
        {
          "id": "passage-ar-00122",
          "level": 2,
          "kind": "group",
          "label": "المنهج الأول: في أحوال نفس الوجود"
        },
        {
          "id": "passage-ar-00123",
          "level": 3,
          "kind": "chapter",
          "label": "١. في موضوعيته للعلم الإلهي وأولية ارتسامه في النفس"
        },
        {
          "id": "passage-ar-00134",
          "level": 3,
          "kind": "chapter",
          "label": "٢. في أن مفهوم الوجود مشترك محمول على ما تحته حمل التشكيك لا حمل التواطؤ"
        },
        {
          "id": "passage-ar-00139",
          "level": 3,
          "kind": "chapter",
          "label": "٣. في أن الوجود العام البديهي اعتبار عقلي غير مقوم لافراده"
        },
        {
          "id": "passage-ar-00142",
          "level": 3,
          "kind": "chapter",
          "label": "٤. في أن للوجود حقيقة عينيه"
        },
        {
          "id": "passage-ar-00144",
          "level": 4,
          "kind": "section",
          "label": "١. بحث ومخلص"
        },
        {
          "id": "passage-ar-00152",
          "level": 3,
          "kind": "chapter",
          "label": "٥. في أن تخصص الوجود بما ذا"
        },
        {
          "id": "passage-ar-00161",
          "level": 3,
          "kind": "chapter",
          "label": "٦. في أن الوجودات هويات بسيطه وان حقيقة الوجود ليست معنى جنسيا"
        },
        {
          "id": "passage-ar-00165",
          "level": 3,
          "kind": "chapter",
          "label": "٧. في أن حقيقة الوجود لا سبب لها بوجه من الوجوه"
        },
        {
          "id": "passage-ar-00196",
          "level": 3,
          "kind": "chapter",
          "label": "٨. في مساوقة الوجود للشيئية"
        },
        {
          "id": "passage-ar-00202",
          "level": 3,
          "kind": "chapter",
          "label": "٩. في الوجود الرابطي"
        },
        {
          "id": "passage-ar-00206",
          "level": 2,
          "kind": "group",
          "label": "المنهج الثاني: في أصول الكيفيات وعناصر العقود وخواص كل منها وفيه فصول"
        },
        {
          "id": "passage-ar-00207",
          "level": 3,
          "kind": "chapter",
          "label": "١. في تعريف الوجوب والامكان والامتناع والحق والباطل ان من المعاني"
        },
        {
          "id": "passage-ar-00222",
          "level": 3,
          "kind": "chapter",
          "label": "٢. في أن واجب الوجود لا يكون بالذات وبالغير جميعا وفي عدم العلاقة اللزومية"
        },
        {
          "id": "passage-ar-00228",
          "level": 3,
          "kind": "chapter",
          "label": "٣. في أن واجب الوجود أنيته ماهيته"
        },
        {
          "id": "passage-ar-00266",
          "level": 3,
          "kind": "chapter",
          "label": "٤. في أن الواجب لذاته واجب من جميع جهاته"
        },
        {
          "id": "passage-ar-00278",
          "level": 3,
          "kind": "chapter",
          "label": "٥. في أن واجب الوجود واحد لا بمعنى ان نوعه منحصر في شخصه على ما توهم"
        },
        {
          "id": "passage-ar-00289",
          "level": 3,
          "kind": "chapter",
          "label": "٦. في استيناف القول في الجهات ودفع شكوك قيلت في لزومها"
        },
        {
          "id": "passage-ar-00307",
          "level": 3,
          "kind": "chapter",
          "label": "٧. في استقراء المعاني التي يستعمل فيها لفظ الامكان"
        },
        {
          "id": "passage-ar-00317",
          "level": 3,
          "kind": "chapter",
          "label": "٨. فيه ارجاع الكلام إلى احكام هذه المفهومات العقلية"
        },
        {
          "id": "passage-ar-00328",
          "level": 3,
          "kind": "chapter",
          "label": "٩. في أن الامكان يستحيل ان يكون بالغير"
        },
        {
          "id": "passage-ar-00344",
          "level": 4,
          "kind": "section",
          "label": "١. بحث وتنقيح"
        },
        {
          "id": "passage-ar-00372",
          "level": 3,
          "kind": "chapter",
          "label": "١٠. في أن الممكن على اي وجه يكون مستلزما للممتنع بالذات"
        },
        {
          "id": "passage-ar-00388",
          "level": 3,
          "kind": "chapter",
          "label": "١١. في ابطال كون الشئ أولى له الوجود أو العدم أولوية غير بالغه حد الوجوب"
        },
        {
          "id": "passage-ar-00402",
          "level": 3,
          "kind": "chapter",
          "label": "١٢. في أن عله الحاجة إلى العلة هي الامكان في الماهيات والقصور في الوجودات"
        },
        {
          "id": "passage-ar-00416",
          "level": 3,
          "kind": "chapter",
